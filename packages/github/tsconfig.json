{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true // type-check only: consumers import github.ts as source
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
