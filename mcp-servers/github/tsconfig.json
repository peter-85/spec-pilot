{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "erasableSyntaxOnly": true, // Node only strips types; reject syntax it cannot run
    "skipLibCheck": true,
    "noEmit": true // type-check only: Node runs the .ts files directly
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules"]
}
